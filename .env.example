# JevRoute Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Mock/rules-only mode requires no credentials.

# ── Jev API (Phase 3) ──────────────────────────────────────────────────────────
# OQ-001: Jev API interface is documented here as an assumption.
# Actual base URL and model identifier must be confirmed from Jev documentation.
JEV_API_KEY=
JEV_BASE_URL=https://api.jev.ai
JEV_MODEL=
# OQ-002: Pricing model below assumes per-token. Update if Jev uses per-decision pricing.
JEV_INPUT_PRICE=
JEV_OUTPUT_PRICE=
JEV_TIMEOUT_S=10.0
JEV_SCHEMA_VERSION=jev-support-v1

# ── LLM Provider (Phase 2) ─────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_INPUT_PRICE=
MODEL_OUTPUT_PRICE=
