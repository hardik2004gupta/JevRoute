# JevRoute Dashboard — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real keys.

# URL of the JevRoute benchmark API server (local or remote).
# The dashboard uses this for LIVE mode. Leave blank to rely on demo mode.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to default the dashboard to DEMO mode on first load.
# Recommended for public Vercel deployments where no backend is running.
NEXT_PUBLIC_DEMO_MODE=true
